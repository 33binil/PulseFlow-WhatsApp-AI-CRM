# Database & Authentication
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/pulseflow_crm?retryWrites=true&w=majority"
JWT_SECRET="replace_with_64_byte_cryptographic_secret"
JWT_EXPIRES_IN="7d"

# AI Providers (Service Layer supports OpenAI & Gemini)
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-replace_with_openai_api_key"
OPENAI_MODEL="gpt-4o-mini"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# Meta WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN="EAAG_replace_with_meta_permanent_access_token"
WHATSAPP_PHONE_NUMBER_ID="109283746512345"
WHATSAPP_BUSINESS_ACCOUNT_ID="987654321098765"
WHATSAPP_VERIFY_TOKEN="pulseflow_webhook_verify_secret_token"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_APP_SECRET="replace_with_meta_app_secret_for_hmac_sha256"

# Optional External Automation (n8n Webhook Integration)
N8N_WEBHOOK_URL="https://n8n.example.com/webhook/whatsapp-crm-events"
N8N_API_KEY="replace_with_optional_n8n_header_secret"

# Application URLs
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"
APP_URL="MY_APP_URL"
PORT="3000"
NODE_ENV="development"

